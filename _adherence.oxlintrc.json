{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/marketing/**",
              "site/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Libre Franklin))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Libre Franklin."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|lane|as|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, lane, as, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='lane'] > Literal[value!=/^(?:fellows|residents|consulting|partner)$/]",
        "message": "<Button> lane must be one of 'fellows' | 'residents' | 'consulting' | 'partner'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tint|elevated|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tint, elevated, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tint'] > Literal[value!=/^(?:white|cream|sage|mist)$/]",
        "message": "<Card> tint must be one of 'white' | 'cream' | 'sage' | 'mist'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:lane|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: lane, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='lane'] > Literal[value!=/^(?:fellows|residents|consulting|partner|warm|neutral)$/]",
        "message": "<Eyebrow> lane must be one of 'fellows' | 'residents' | 'consulting' | 'partner' | 'warm' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|copy|lane|image|imageFallback|focus|actions|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: eyebrow, title, copy, lane, image, imageFallback, focus, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute[name.name='lane'] > Literal[value!=/^(?:fellows|residents|consulting|partner)$/]",
        "message": "<Hero> lane must be one of 'fellows' | 'residents' | 'consulting' | 'partner'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LaneCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:lane|index|title|children|link|key|ref|className|style|children)$/]",
        "message": "<LaneCard> doesn't accept that prop. Declared props: lane, index, title, children, link."
      },
      {
        "selector": "JSXOpeningElement[name.name='LaneCard'] > JSXAttribute[name.name='lane'] > Literal[value!=/^(?:fellows|residents|consulting|partner)$/]",
        "message": "<LaneCard> lane must be one of 'fellows' | 'residents' | 'consulting' | 'partner'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrincipleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|children|link|tint|key|ref|className|style|children)$/]",
        "message": "<PrincipleCard> doesn't accept that prop. Declared props: index, title, children, link, tint."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrincipleCard'] > JSXAttribute[name.name='tint'] > Literal[value!=/^(?:white|cream|sage)$/]",
        "message": "<PrincipleCard> tint must be one of 'white' | 'cream' | 'sage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignalItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|detail|key|ref|className|style|children)$/]",
        "message": "<SignalItem> doesn't accept that prop. Declared props: label, detail."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:disclaimer|brandLine|sponsorLink|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: disclaimer, brandLine, sponsorLink."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:lane|shape|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: lane, shape, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='lane'] > Literal[value!=/^(?:fellows|residents|consulting|partner|neutral)$/]",
        "message": "<Tag> lane must be one of 'fellows' | 'residents' | 'consulting' | 'partner' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:pill|square)$/]",
        "message": "<Tag> shape must be one of 'pill' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:step|title|children|key|ref|className|style|children)$/]",
        "message": "<TimelineStep> doesn't accept that prop. Declared props: step, title, children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
